#!/bin/sh
# Runs identify.py bound to the physical console (tty1) regardless of
# how this was invoked -- same as /usr/local/bin/bars: the
# KD_GRAPHICS ioctl on /dev/tty needs a real tty1 controlling terminal,
# which SSH sessions don't provide.
if [ "$(tty 2>/dev/null)" = "/dev/tty1" ]; then
    exec python3 /opt/identify/identify.py "$@"
else
    exec sudo openvt -f -c 1 -s -w -- python3 /opt/identify/identify.py "$@"
fi
